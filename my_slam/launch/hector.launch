<?xml version="1.0"?>
<launch>

    <!-- ============================================ -->
    <!-- HECTOR SLAM WITH RPLIDAR - COMPLETE LAUNCH   -->
    <!-- ============================================ -->

    <!-- Set simulation time to false (using real LiDAR) -->
    <param name="/use_sim_time" value="false"/>

    <!-- ============================================ -->
    <!-- Terminal 1: ROS Core (roscore)               -->
    <!-- ============================================ -->
    <!-- NOTE: roscore is started automatically when you run roslaunch -->


    <!-- ============================================ -->
    <!-- Terminal 2: RPLIDAR Driver                   -->
    <!-- ============================================ -->
    <node pkg="rplidar_ros" type="rplidarNode" name="rplidarNode" output="screen">
        <param name="serial_port" value="/dev/ttyUSB0"/>
        <param name="serial_baudrate" value="115200"/>
        <param name="frame_id" value="laser"/>
        <param name="inverted" value="false"/>
        <param name="angle_compensate" value="true"/>
    </node>


    <!-- ============================================ -->
    <!-- Terminal 3: Static Transform (map → laser)   -->
    <!-- ============================================ -->
    <node pkg="tf" type="static_transform_publisher" name="map_to_laser_broadcaster" 
          args="0 0 0 0 0 0 map laser 100"/>


    <!-- ============================================ -->
    <!-- Terminal 4: Hector SLAM Node                 -->
    <!-- ============================================ -->
    <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
        <!-- Frame parameters -->
        <param name="map_frame" value="map"/>
        <param name="base_frame" value="laser"/>
        <param name="odom_frame" value="laser"/>
        
        <!-- Topic parameters -->
        <param name="scan_topic" value="/scan"/>
        
        <!-- Map parameters -->
        <param name="map_resolution" value="0.05"/>
        <param name="map_size" value="2048"/>
        
        <!-- Update thresholds (for better responsiveness) -->
        <param name="map_update_distance_thresh" value="0.05"/>
        <param name="map_update_angle_thresh" value="0.05"/>
        
        <!-- Laser range limits -->
        <param name="laser_max_dist" value="5.0"/>
        <param name="laser_min_dist" value="0.15"/>
        
        <!-- Map publishing -->
        <param name="map_pub_period" value="0.2"/>
        <param name="pub_map_odom_transform" value="true"/>
    </node>


    <!-- ============================================ -->
    <!-- Terminal 5: RViz Visualization               -->
    <!-- ============================================ -->
    <node pkg="rviz" type="rviz" name="rviz" required="true" 
          args="-d $(find my_slam)/launch/hector.rviz"/>

</launch>
